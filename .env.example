# Get your API key from https://developer.riotgames.com/
RIOT_API_KEY=your_riot_api_key_here
PORT=3000

# Region configuration (optional)
# Regional API options: europe, americas, asia, sea
DEFAULT_REGION=europe

# Platform options: euw1, eun1, na1, kr, jp1, br1, la1, la2, oc1, tr1, ru, ph2, sg2, th2, tw2, vn2
DEFAULT_PLATFORM=euw1
